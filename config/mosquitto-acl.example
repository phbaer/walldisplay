# Example for base topic panel/living-room; use distinct credentials per panel.
# Replace usernames and exact discovery IDs together when changing the panel topic.
user panel-living-room
topic read panel/living-room/set/#
topic read panel/living-room/state/#
topic read panel/living-room/cmd/#
topic read homeassistant/status
topic write panel/living-room/status
topic write panel/living-room/state/#
topic write panel/living-room/cmd/media/#
topic write panel/living-room/cmd/sync
topic write panel/living-room/cmd/button1
topic write panel/living-room/cmd/button2
topic write panel/living-room/cmd/button3
topic write panel/living-room/cmd/button4
topic write panel/living-room/cmd/button5
topic write panel/living-room/cmd/grid1
topic write panel/living-room/cmd/grid2
topic write panel/living-room/cmd/grid3
topic write panel/living-room/cmd/grid4
topic write panel/living-room/cmd/grid5
topic write panel/living-room/cmd/grid6

# Scope discovery publication to this panel, not homeassistant/#.
topic write homeassistant/button/panel_living_room_button1/config
topic write homeassistant/button/panel_living_room_button2/config
topic write homeassistant/button/panel_living_room_button3/config
topic write homeassistant/button/panel_living_room_button4/config
topic write homeassistant/button/panel_living_room_button5/config
